{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "migrate:lkt-access-notifications": "node migrations/lkt-access-notifications.mjs",
    "migrate:lkt-report-findings": "node migrations/lkt-report-findings.mjs",
    "migrate:lkt-consultation-specialists": "node migrations/lkt-consultation-specialists.mjs",
    "migrate:lkt-evidence-archives": "node migrations/lkt-evidence-archives.mjs",
    "migrate:lkt-report-cycles": "node migrations/lkt-report-cycles.mjs",
    "migrate:lkt-reference-digests": "node migrations/lkt-reference-digests.mjs",
    "migrate:lkt-editorial": "node migrations/lkt-editorial.mjs",
    "migrate:lkt-access-audit": "node migrations/lkt-access-audit.mjs",
    "migrate:lkt-consultation-snapshot": "node migrations/lkt-consultation-snapshot.mjs",
    "migrate:lkt-auth": "node migrations/lkt-auth.mjs",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
