{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:report-cycles": "tsx --test src/lib/lkt-report-cycles.test.ts",
    "test:reference-digest": "tsx --test src/lib/lkt-reference-digest.test.ts",
    "editorial:member": "tsx src/scripts/editorial-member.ts",
    "test:editorial": "tsx --test src/lib/lkt-editorial.test.ts",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:references": "esbuild src/lib/lkt-content.test.ts --bundle --platform=node --format=esm --outfile=../../generated-artifacts/tests/lkt-content.test.mjs && node --test ../../generated-artifacts/tests/lkt-content.test.mjs",
    "test:auth": "tsx --test src/lib/lkt-auth.test.ts",
    "test:message-history": "tsx --test src/lib/lkt-message-history.test.ts",
    "test:consultation-snapshots": "tsx --test src/lib/lkt-consultation-snapshot.test.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.88",
    "@clerk/shared": "^4.44.1",
    "@google-cloud/storage": "^8.4.0",
    "@replit/connectors-sdk": "^0.7.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.3",
    "http-proxy-middleware": "^4.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
